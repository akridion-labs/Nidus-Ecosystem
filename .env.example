# Copy to .env.local and fill in. Never commit a real value.
# Secrets belong in a secret manager in production, not in a file on disk.

DATABASE_URL=postgres://nidus:CHANGE_ME@127.0.0.1:5432/nidus
TEST_DATABASE_URL=postgres://nidus:CHANGE_ME@127.0.0.1:5432/nidus_test

# Loopback on purpose. RUNBOOK 07 for AKRIDION-AI-01: never bind the first
# deployment to 0.0.0.0, and do not create a router port-forward.
HOST=127.0.0.1
PORT=8787

# Comma-separated. A mutation from any other origin is refused.
ALLOWED_ORIGINS=http://localhost:5173

# Operator endpoints stay disabled (404) until this is set.
OPERATOR_TOKEN=

RANKER_VERSION=nidus-ranker-0.2.0-pilot

# ---- Sign in with Google -----------------------------------------------
# Leave these blank and the sign-in button says what is missing rather than
# failing silently. Nothing else in Nidus stops working without them.
#
# To fill them in (about five minutes, and only you can do it):
#   1. console.cloud.google.com -> create or pick a project
#   2. APIs & Services -> OAuth consent screen -> External -> fill the basics
#   3. Credentials -> Create credentials -> OAuth client ID -> Web application
#   4. Authorised redirect URI, EXACTLY this, including the path:
#        http://localhost:8787/api/auth/google/callback
#   5. Copy the client ID and secret below, then restart the server
#
# The secret belongs in a secret manager in production, not in a file on disk.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# Where the reader is sent back to after signing in.
APP_URL=http://localhost:5173
